NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by /api/admin/generate-post to draft articles with GPT-4o.
# Never exposed to the browser (no NEXT_PUBLIC_ prefix).
OPENAI_API_KEY=

# Server-only. SMTP relay for transactional email: contact form notifications,
# guestbook/comment moderation alerts, subscribe confirmations, and new-article
# emails to subscribers. Configured here for Resend's SMTP relay (resend.com) —
# host smtp.resend.com, port 465, user "resend", pass = your Resend API key.
# Any standard SMTP provider works the same way.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
# Must be an address on a domain you've verified with your SMTP provider.
# No surrounding quotes — Vercel's dashboard env var UI stores them literally
# (unlike dotenv), which breaks the SMTP envelope sender.
EMAIL_FROM=Nyuydine Bill Leynyuy <notifications@yourdomain.com>
# Where contact form / guestbook / comment moderation alerts are sent.
ADMIN_EMAIL=
# Used to build article links in subscriber notification emails.
NEXT_PUBLIC_SITE_URL=https://nyuydine.online
